# =============================================================================
# .env.live.example — PRODUCTION template (data.tcrce.ca)
#
# Copy to `.env.live` on the server and fill in. NEVER commit the filled copy.
# Mandatory production fields only — no dev/testing vars (AUTH_MODE=dev,
# DEV_FAKE_UPN, ALLOW_DEV_AUTH are intentionally omitted; a production container
# must fail closed if it isn't in entra mode).
#
# Secrets: the three *_SECRET values below may instead be supplied from podman's
# secret store at run time (--secret <name>,type=env,target=<VAR>). If you do
# that, leave those three BLANK/removed here and keep this file as non-secret
# config only. See docs/it-deployment (podman secrets section).
# =============================================================================

# --- Runtime mode (production MUST be 'entra') ---
AUTH_MODE=entra

# --- Public URL — must match how the browser reaches the app ---
AUTH_URL=https://data.tcrce.ca
# Trust the reverse-proxy host/proto when building callback URLs. The proxy must
# forward X-Forwarded-Proto=https and the Host header, or sign-in will loop.
AUTH_TRUST_HOST=true
# Session/JWT encryption key: `openssl rand -base64 32`. Keep STABLE across
# deploys (regenerating invalidates every active session).           [SECRET]
AUTH_SECRET=

# --- LOGIN app registration (interactive sign-in; delegated scopes; NO data access) ---
# Register redirect URI: https://data.tcrce.ca/api/auth/callback/microsoft-entra-id
AUTH_ENTRA_TENANT_ID=
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_CLIENT_SECRET=                                            # [SECRET]

# --- WAREHOUSE service principal (data access; holds the DB grants) ---
# Same tenant as the login app (single-tenant TCRCE); distinct client + secret.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=                                                 # [SECRET]

# --- Fabric Warehouse (server-side connection) ---
FABRIC_SQL_SERVER=xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=Assessment_Warehouse

# --- OneLake landing zone (required for the in-app PowerSchool ingest) ---
ONELAKE_WORKSPACE=
ONELAKE_LANDING_LAKEHOUSE=

# --- PIIDPA residency (deploy target MUST be a Canadian region) ---
DATA_REGION=canadaeast
