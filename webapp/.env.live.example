# =============================================================================
# .env.live.example — PRODUCTION template (data.tcrce.ca)
#
# Copy to `.env.live` on the server and fill in. NEVER commit the filled copy.
# Mandatory production fields only — no dev/testing vars (AUTH_MODE=dev,
# DEV_FAKE_UPN, ALLOW_DEV_AUTH are intentionally omitted; a production container
# must fail closed if it isn't in entra mode).
#
# Secrets via podman's secret store (RECOMMENDED): the three [SECRET] values below are
# FILE-MOUNTED, not put in this file — so they are COMMENTED OUT here by default and this
# file holds non-secret config only. Create each as a podman secret, mount it, and point a
# *_FILE env var at the mount; the container's preloader (load-secrets.cjs) reads the file
# into the matching env var before the server starts.
# (If you are NOT using the secret store, uncomment the three lines and set them inline. Do
# NOT leave them present-but-empty: an empty AUTH_SECRET= boots with a blank key instead of
# failing loudly.)
#
#   printf %s 'THE-VALUE' | podman secret create aw_auth_secret -
#   printf %s 'THE-VALUE' | podman secret create aw_login_secret -
#   printf %s 'THE-VALUE' | podman secret create aw_wh_secret -
#
#   podman run -d --name aw --restart=unless-stopped \
#     --env-file /etc/assessment/.env.live \
#     --secret aw_auth_secret  -e AUTH_SECRET_FILE=/run/secrets/aw_auth_secret \
#     --secret aw_login_secret -e AUTH_ENTRA_CLIENT_SECRET_FILE=/run/secrets/aw_login_secret \
#     --secret aw_wh_secret    -e ENTRA_CLIENT_SECRET_FILE=/run/secrets/aw_wh_secret \
#     -p 3000:3000 assessment-webapp:token
# =============================================================================

# --- Runtime mode (production MUST be 'entra') ---
AUTH_MODE=entra

# --- Public URL — must match how the browser reaches the app ---
AUTH_URL=https://data.tcrce.ca
# Trust the reverse-proxy host/proto when building callback URLs. The proxy must
# forward X-Forwarded-Proto=https and the Host header, or sign-in will loop.
AUTH_TRUST_HOST=true
# Session/JWT encryption key: `openssl rand -base64 32`. Keep STABLE across deploys
# (regenerating invalidates every active session). [SECRET — via AUTH_SECRET_FILE by default]
#AUTH_SECRET=

# --- LOGIN app registration (interactive sign-in; delegated scopes; NO data access) ---
# Register redirect URI: https://data.tcrce.ca/api/auth/callback/microsoft-entra-id
AUTH_ENTRA_TENANT_ID=
AUTH_ENTRA_CLIENT_ID=
#AUTH_ENTRA_CLIENT_SECRET=                     # [SECRET — via AUTH_ENTRA_CLIENT_SECRET_FILE by default]

# --- WAREHOUSE service principal (data access; holds the DB grants) ---
# Same tenant as the login app (single-tenant TCRCE); distinct client + secret.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
#ENTRA_CLIENT_SECRET=                          # [SECRET — via ENTRA_CLIENT_SECRET_FILE by default]

# --- Fabric Warehouse (server-side connection) ---
FABRIC_SQL_SERVER=xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=Assessment_Warehouse

# --- OneLake landing zone (required for the in-app PowerSchool ingest) ---
ONELAKE_WORKSPACE=
ONELAKE_LANDING_LAKEHOUSE=

# --- PIIDPA residency (deploy target MUST be a Canadian region) ---
DATA_REGION=canadaeast
