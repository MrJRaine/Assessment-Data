# =============================================================================
# .env.loadtest.example — LOAD-TEST build template (loadtest branch ONLY)
#
# Copy to `.env.loadtest` and fill in. NEVER commit the filled copy. NEVER use these values on
# production. This env runs the Entra-BYPASS build against the DEV warehouse so a Locust cluster can
# drive it without Microsoft sign-in. The startup guard (assertLoadtestSafe) REFUSES to boot unless:
#   - FABRIC_SQL_DATABASE ends in _Dev, AUTH_URL is not data.tcrce.ca,
#   - AUTH_MODE=dev + ALLOW_DEV_AUTH=true, and LOADTEST_KEY is set.
#
# Secrets (ENTRA_CLIENT_SECRET, AUTH_SECRET, LOADTEST_KEY) are ABSENT here — supply them at deploy
# time via podman --secret / a k8s Secret, or fill them into the local .env.loadtest (gitignored).
# =============================================================================

# --- Dev-auth mode (bypass requires dev mode) ---
AUTH_MODE=dev
ALLOW_DEV_AUTH=true
ALLOW_IMPERSONATION=true
# Fallback identity when a request omits X-Loadtest-User (must exist in the dev warehouse).
DEV_FAKE_UPN=teacher@tcrce.ca

# --- Public URL: the staging host:port Locust hits (DIRECT to the container, http). NOT data.tcrce.ca.
#     Use port 3001 to stay clear of the live deploy's 3000. ---
AUTH_URL=http://STAGING_IP:3001
AUTH_TRUST_HOST=true
# AUTH_SECRET: required by NextAuth init even though bypass mode creates no sessions. Any 32-byte
# base64 value (`openssl rand -base64 32`). Supply via secret or fill in the local .env.loadtest.

# --- Fabric DEV Warehouse (server-side connection; MUST be the *_Dev database) ---
FABRIC_SQL_SERVER=xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=Assessment_Warehouse_Dev
# Connection-pool ceiling — the sweep knob for the load test.
FABRIC_POOL_MAX=20

# --- Data service principal (reads the DEV warehouse). ENTRA_CLIENT_SECRET is a DEV credential,
#     supplied via secret; the tenant/client IDs are non-secret config. ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# --- PIIDPA residency ---
DATA_REGION=canadaeast

# --- LOAD-TEST bypass ---
LOADTEST_AUTH_BYPASS=true
# LOADTEST_KEY: the shared secret every request must send as X-Loadtest-Key. Store as a k8s Secret;
# do NOT commit it. (Absent here on purpose.)
# Allow-list of impersonatable synthetic UPNs (comma-separated) — fill from
# sql/scripts/list_loadtest_identities.sql (≈2 analysts, 2 admins, 16 teachers).
LOADTEST_USERS=
# Optional advisory source allow-list (the VLAN firewall is the real perimeter).
LOADTEST_ALLOWED_CIDRS=10.0.0.0/24
