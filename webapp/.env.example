# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).

# --- Auth ---
# 'dev'   = use DEV_FAKE_UPN below (LOCAL ONLY; never deploy with this).
# 'entra' = MSAL on-behalf-of flow (pending the Entra app registration).
AUTH_MODE=dev
DEV_FAKE_UPN=teacher@tcrce.ca

# --- Fabric Warehouse (server-side connection only) ---
# SQL analytics endpoint of the Assessment workspace warehouse.
FABRIC_SQL_SERVER=xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=Assessment_Warehouse

# --- Entra app registration (for AUTH_MODE=entra and/or the Fabric connection) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Auth.js (NextAuth) ---
# Session/JWT encryption key. Generate: `openssl rand -base64 32`
AUTH_SECRET=
# Trust the container/proxy host when building callback URLs (set in the Dockerfile too).
AUTH_TRUST_HOST=true
# Entra app registration redirect URI to add: http://localhost:3000/api/auth/callback/microsoft-entra-id

# --- PIIDPA residency intent ---
# Surfaced on the landing page / health check. Deploy target MUST be a Canadian region.
DATA_REGION=canadaeast
