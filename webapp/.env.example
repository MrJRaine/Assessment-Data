# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).

# --- Auth ---
# 'dev'   = use DEV_FAKE_UPN below (LOCAL ONLY; never deploy with this).
# 'entra' = MSAL on-behalf-of flow (pending the Entra app registration).
AUTH_MODE=dev
DEV_FAKE_UPN=teacher@tcrce.ca

# --- Fabric Warehouse (server-side connection only) ---
# SQL analytics endpoint of the Assessment workspace warehouse.
FABRIC_SQL_SERVER=xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=Assessment_Warehouse

# Secret handling: the three *_SECRET values (ENTRA_CLIENT_SECRET, AUTH_ENTRA_CLIENT_SECRET,
# AUTH_SECRET) can be FILE-MOUNTED instead of set here — set <NAME>_FILE to the mount path
# (e.g. a podman --secret at /run/secrets/...) and the container preloader reads it in. See
# .env.live.example for the full podman-secret run command.

# --- WAREHOUSE service principal (data access; holds the Fabric DB grants) ---
# Used by db.ts for the app-only connection to the warehouse. This is the DATA identity.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- LOGIN app registration (interactive sign-in; delegated; NO data access) ---
# Used by auth.ts. SEPARATE registration from the warehouse SP above (no fallback — for
# AUTH_MODE=entra these must be set). Same tenant as ENTRA_TENANT_ID (single-tenant TCRCE).
AUTH_ENTRA_TENANT_ID=
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_CLIENT_SECRET=

# --- Auth.js (NextAuth) ---
# Session/JWT encryption key. Generate: `openssl rand -base64 32`. Keep STABLE across
# deploys (regenerating invalidates every active session).
AUTH_SECRET=
# Trust the container/proxy host when building callback URLs (also set trustHost in auth.ts).
AUTH_TRUST_HOST=true
# Canonical public URL — MUST match how the browser reaches the app. This is PER-ENVIRONMENT:
#   local testing : AUTH_URL=http://localhost:3000
#   production     : AUTH_URL=https://data.tcrce.ca
AUTH_URL=http://localhost:3000
# Entra app-registration redirect URIs to register (IT-gated — see memory: Entra app reg is IT-gated):
#   local dev  : http://localhost:3000/api/auth/callback/microsoft-entra-id
#   production : https://data.tcrce.ca/api/auth/callback/microsoft-entra-id
# Behind the data.tcrce.ca reverse proxy: terminate TLS there and forward X-Forwarded-Proto=https
# + the Host header to the container's :3000, so callback URLs build as https and cookies stay Secure.

# --- PIIDPA residency intent ---
# Surfaced on the landing page / health check. Deploy target MUST be a Canadian region.
DATA_REGION=canadaeast
